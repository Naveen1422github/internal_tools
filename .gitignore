# Secrets — never commit (clean-room gate §5)
.env
.env.*
!.env.example
*.pem
post-office-data/

# Local DB — never commit
collab.db
collab.db-journal
collab.db-wal
collab.db-shm

# Exports — gitignored by default; promote to git if you want team sharing
export/

# Build artifacts
node_modules/
dist/
dist-share/
vendor/
*.tsbuildinfo
data/sessions.json

# Agent exhaust — logs, crash dumps, stray package caches
*.log
*.stackdump
**/.npm-cache/

# Backup snapshots — local/Drive only, never git
backups/
*.db.gz
*.db.tmp

# brainstorming companion mockups (local only)
.superpowers/

# Build identity (written by npm run build)
build-info.json

# Assembled package (npm run package)
dist-package/
