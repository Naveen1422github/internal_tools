{
  "name": "internal-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Unified internal tools workspace.",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "core",
    "mcp",
    "server",
    "ui",
    "gemini-mcp"
  ],
  "scripts": {
    "start": "npm -w @collab-mcp/server run build && node server/dist/server.js",
    "dev": "npm -w @collab-mcp/server run dev",
    "test": "npm -w @collab-mcp/server run build && tsx --test test/**/*.test.mts",
    "build": "npm -w @collab-mcp/core run build && npm run build --workspaces --if-present",
    "bundle": "node scripts/bundle.mjs",
    "fetch:crsqlite": "node scripts/fetch-crsqlite.mjs",
    "test:all": "npm run test --workspaces --if-present && tsx --test test/**/*.test.mts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "mcp:dev": "npm --prefix mcp run dev",
    "mcp:build": "npm --prefix mcp run build",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "typescript": "~5.3.3",
    "typescript-eslint": "^8.61.0"
  }
}
